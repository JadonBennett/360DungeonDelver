# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# C# files should use CRLF (Windows-style) line endings
*.cs text eol=crlf

# Godot-specific text files
*.tscn text
*.tres text
*.gd text
*.import text

# Binary assets do not diff/merge as text
*.png binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.glb binary
*.gltf binary